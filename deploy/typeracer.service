# systemd service that keeps the Next.js app running on the VPS.
# Install: sudo cp deploy/typeracer.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now typeracer
[Unit]
Description=NelumboType (Next.js)
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/typeracer
Environment=NODE_ENV=production
# server.ts runs Next.js and Socket.IO together (needs Node 22.6+ for type
# stripping). Next.js reads .env.production.local itself. It listens on
# localhost only; Caddy is the public entry point and passes WebSockets through.
Environment=HOST=127.0.0.1
Environment=PORT=3000
ExecStart=/usr/bin/node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON server.ts
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
