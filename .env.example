# Copy to .env.local. Matches the local database in docker-compose.yml.
DATABASE_URL=postgres://typeracer:typeracer@localhost:5432/typeracer

# Signs the session cookie. At least 32 characters; generate one with:
#   openssl rand -base64 48
SESSION_SECRET=

# Production only (the VPS's .env.production.local): password of the database
# started by docker-compose.prod.yml. DATABASE_URL must use the same password.
POSTGRES_PASSWORD=
