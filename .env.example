# Copy to .env.local. Matches the local database in docker-compose.yml.
DATABASE_URL=postgres://typeracer:typeracer@localhost:5432/typeracer

# Signs the session cookie. At least 32 characters; generate one with:
#   openssl rand -base64 48
SESSION_SECRET=

# Public address of the site, used to build the OAuth callback URLs. Needed in
# production (behind Caddy the app can't see it); locally it defaults to the
# address the browser used.
#   production: APP_URL=https://nelumbotype.online
APP_URL=

# OAuth apps. A provider without its id and secret shows "not available" on
# the login page; the rest of the site works without them.
# Register the callback URL <APP_URL>/api/auth/<provider>/callback:
#   GitHub: https://github.com/settings/developers > OAuth Apps > New OAuth App
#     Authorization callback URL: http://localhost:3000/api/auth/github/callback
#   Discord: https://discord.com/developers/applications > OAuth2 > Redirects
#     http://localhost:3000/api/auth/discord/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Production only (the VPS's .env.production.local): password of the database
# started by docker-compose.prod.yml. DATABASE_URL must use the same password.
POSTGRES_PASSWORD=
